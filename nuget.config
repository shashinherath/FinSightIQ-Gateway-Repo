<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="finsightiq" value="https://nuget.pkg.github.com/shashinherath/index.json" />
  </packageSources>
  <!-- No credentials are stored here. Supply them via the NUGET_TOKEN environment variable
       (a PAT with read:packages) or, in Actions, GITHUB_TOKEN. -->
  <packageSourceCredentials>
    <finsightiq>
      <add key="Username" value="shashinherath" />
      <add key="ClearTextPassword" value="%NUGET_TOKEN%" />
    </finsightiq>
  </packageSourceCredentials>
</configuration>
