# ==============================================================================
# FinSightIQ API Gateway — Local Environment Configuration
# ==============================================================================
# Copy this file to '.env' for local container or environment configuration:
#   cp .env.example .env
#
# DO NOT commit '.env' or real secrets to source control.
# ==============================================================================

# ASP.NET Core Runtime Mode
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Security & JWT Authentication (RS256 Public Key)
# In Development mode, an ephemeral RSA key is generated automatically if empty.
# In Staging and Production, a valid PEM string or path to public key file is required.
Jwt__Issuer=finsightiq
Jwt__Audience=finsightiq
Jwt__PublicKeyPem=

# Distributed Cache & Quota Store (Optional in Development; in-memory fallback active)
# In Docker Compose, set to: redis:6379,password=redis_dev_password,abortConnect=false
Redis__ConnectionString=

# Downstream Service Destination Addresses (Local Development Ports)
ReverseProxy__Clusters__UserService__Destinations__Default__Address=http://localhost:5101
ReverseProxy__Clusters__MarketDataService__Destinations__Default__Address=http://localhost:5102
ReverseProxy__Clusters__PredictionService__Destinations__Default__Address=http://localhost:5103
ReverseProxy__Clusters__PortfolioService__Destinations__Default__Address=http://localhost:5104
ReverseProxy__Clusters__SentimentService__Destinations__Default__Address=http://localhost:5105
