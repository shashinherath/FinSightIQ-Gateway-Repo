{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Gateway": {
    "Cors": {
      "AllowedOrigins": [
        "https://finsightiq.io",
        "https://app.finsightiq.io"
      ]
    },
    "DownstreamServices": {
      "userService": {
        "BaseUrl": "http://user-service:8080"
      },
      "marketDataService": {
        "BaseUrl": "http://market-data-service:8080"
      },
      "predictionService": {
        "BaseUrl": "http://prediction-service:8080"
      },
      "portfolioService": {
        "BaseUrl": "http://portfolio-service:8080"
      },
      "sentimentService": {
        "BaseUrl": "http://sentiment-service:8080"
      }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "user-service": {
        "Destinations": {
          "default": {
            "Address": "http://user-service:8080"
          }
        }
      },
      "market-data-service": {
        "Destinations": {
          "default": {
            "Address": "http://market-data-service:8080"
          }
        }
      },
      "prediction-service": {
        "Destinations": {
          "default": {
            "Address": "http://prediction-service:8080"
          }
        }
      },
      "portfolio-service": {
        "Destinations": {
          "default": {
            "Address": "http://portfolio-service:8080"
          }
        }
      },
      "sentiment-service": {
        "Destinations": {
          "default": {
            "Address": "http://sentiment-service:8080"
          }
        }
      }
    }
  }
}
