{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Jwt": {
      "Issuer": "finsightiq",
      "Audience": "finsightiq",
      "ClockSkewSeconds": 60,
      "PublicKeyPem": ""
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:5173"
      ],
      "AllowCredentials": true
    },
    "RateLimiting": {
      "AnonymousPermitLimit": 60,
      "AuthenticatedPermitLimit": 600,
      "SlidingWindowSeconds": 60,
      "PredictionDailyQuota": 50,
      "PredictionWindowHours": 24
    },
    "DownstreamServices": {
      "userService": {
        "Name": "User Service",
        "BaseUrl": "http://localhost:5101",
        "HealthEndpoint": "/health/live",
        "IsCritical": true,
        "TimeoutSeconds": 3
      },
      "marketDataService": {
        "Name": "Market Data Service",
        "BaseUrl": "http://localhost:5102",
        "HealthEndpoint": "/health/live",
        "IsCritical": true,
        "TimeoutSeconds": 3
      },
      "predictionService": {
        "Name": "Prediction Service",
        "BaseUrl": "http://localhost:5103",
        "HealthEndpoint": "/health/live",
        "IsCritical": true,
        "TimeoutSeconds": 3
      },
      "portfolioService": {
        "Name": "Portfolio Service",
        "BaseUrl": "http://localhost:5104",
        "HealthEndpoint": "/health/live",
        "IsCritical": true,
        "TimeoutSeconds": 3
      },
      "sentimentService": {
        "Name": "Sentiment Service",
        "BaseUrl": "http://localhost:5105",
        "HealthEndpoint": "/health/live",
        "IsCritical": true,
        "TimeoutSeconds": 3
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-public-register": {
        "ClusterId": "user-service",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/auth/register",
          "Methods": [ "POST" ]
        }
      },
      "auth-public-login": {
        "ClusterId": "user-service",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "auth-public-refresh": {
        "ClusterId": "user-service",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/auth/refresh",
          "Methods": [ "POST" ]
        }
      },
      "auth-public-logout": {
        "ClusterId": "user-service",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/auth/logout",
          "Methods": [ "POST" ]
        }
      },
      "auth-protected": {
        "ClusterId": "user-service",
        "Order": 10,
        "AuthorizationPolicy": "ViewerPolicy",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "watchlists": {
        "ClusterId": "user-service",
        "Order": 10,
        "AuthorizationPolicy": "ViewerPolicy",
        "Match": {
          "Path": "/api/v1/watchlists/{**catch-all}"
        }
      },
      "watchlist-singular": {
        "ClusterId": "user-service",
        "Order": 10,
        "AuthorizationPolicy": "ViewerPolicy",
        "Match": {
          "Path": "/api/v1/watchlist/{**catch-all}"
        }
      },
      "users-admin": {
        "ClusterId": "user-service",
        "Order": 10,
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "market-data": {
        "ClusterId": "market-data-service",
        "Order": 10,
        "AuthorizationPolicy": "ViewerPolicy",
        "Match": {
          "Path": "/api/v1/market/{**catch-all}"
        }
      },
      "market-hub": {
        "ClusterId": "market-data-service",
        "Order": 10,
        "Match": {
          "Path": "/hubs/market/{**catch-all}"
        }
      },
      "prediction-create": {
        "ClusterId": "prediction-service",
        "Order": 5,
        "AuthorizationPolicy": "AnalystPolicy",
        "Match": {
          "Path": "/api/v1/predictions",
          "Methods": [ "POST" ]
        }
      },
      "prediction-retrain": {
        "ClusterId": "prediction-service",
        "Order": 5,
        "AuthorizationPolicy": "AdminPolicy",
        "Match": {
          "Path": "/api/v1/predictions/retrain",
          "Methods": [ "POST" ]
        }
      },
      "predictions-all": {
        "ClusterId": "prediction-service",
        "Order": 10,
        "AuthorizationPolicy": "ViewerPolicy",
        "Match": {
          "Path": "/api/v1/predictions/{**catch-all}"
        }
      },
      "portfolios-root": {
        "ClusterId": "portfolio-service",
        "Order": 5,
        "AuthorizationPolicy": "AnalystPolicy",
        "Match": {
          "Path": "/api/v1/portfolio"
        }
      },
      "portfolios": {
        "ClusterId": "portfolio-service",
        "Order": 10,
        "AuthorizationPolicy": "AnalystPolicy",
        "Match": {
          "Path": "/api/v1/portfolio/{**catch-all}"
        }
      },
      "alerts-root": {
        "ClusterId": "portfolio-service",
        "Order": 5,
        "AuthorizationPolicy": "AnalystPolicy",
        "Match": {
          "Path": "/api/v1/alerts"
        }
      },
      "alerts": {
        "ClusterId": "portfolio-service",
        "Order": 10,
        "AuthorizationPolicy": "AnalystPolicy",
        "Match": {
          "Path": "/api/v1/alerts/{**catch-all}"
        }
      },
      "jobs": {
        "ClusterId": "portfolio-service",
        "Order": 10,
        "AuthorizationPolicy": "ViewerPolicy",
        "Match": {
          "Path": "/api/v1/jobs/{**catch-all}"
        }
      },
      "sentiment": {
        "ClusterId": "sentiment-service",
        "Order": 10,
        "AuthorizationPolicy": "ViewerPolicy",
        "Match": {
          "Path": "/api/v1/sentiment/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-service": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "market-data-service": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "prediction-service": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "portfolio-service": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "sentiment-service": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5105"
          }
        }
      }
    }
  }
}
